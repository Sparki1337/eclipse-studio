{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eclipse Studio",
  "version": "10.1.0",
  "identifier": "studio.sparki.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Eclipse Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "backgroundColor": "#000000",
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: asset: http://asset.localhost https://asset.localhost; font-src 'self' data:; media-src 'self' blob: data: asset: http://asset.localhost https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "Sparki",
    "copyright": "Copyright © 2026 Sparki",
    "shortDescription": "Premium Steam and EOS utility workspace",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/core_engine/": "backend/core_engine/",
      "resources/creamapi/steam_api.dll": "CreamAPI/steam_api.dll",
      "resources/creamapi/steam_api64.dll": "CreamAPI/steam_api64.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
