{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eclipse Studio",
  "version": "6.6.7",
  "identifier": "studio.sparki.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Eclipse Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "backgroundColor": "#090a0d",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "Sparki",
    "copyright": "Copyright © 2026 Sparki",
    "shortDescription": "Premium Steam and EOS utility workspace",
    "icon": [
      "icon.ico"
    ],
    "resources": {
      "../backend/core_engine/": "backend/core_engine/",
      "../CreamAPI/steam_api.dll": "CreamAPI/steam_api.dll",
      "../CreamAPI/steam_api64.dll": "CreamAPI/steam_api64.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
